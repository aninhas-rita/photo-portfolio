# Copy this file to .env.local before running locally.

# Protects /admin. Defaults to "changeme" if unset — fine for a first local
# test, not fine for anything public.
ADMIN_PASSWORD=changeme

# Required for the admin to read/write content and uploads — the site is
# stored in Vercel Blob (not the local filesystem), so this token is needed
# even in local dev. Get it by connecting a Blob store to this project on
# vercel.com (Storage tab), then run `vercel env pull .env.local` to pull
# it down automatically, or copy it manually from the store's settings.
BLOB_READ_WRITE_TOKEN=
